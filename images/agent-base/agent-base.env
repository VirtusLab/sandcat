# Tag of the published agent base image (ghcr.io/virtuslab/sandcat-agent-base).
# Rebuilt weekly and on changes, under the same tag. Bump it only when a
# change would break Dockerfile.app of already generated projects.
#
# Must stay equal to SCT_AGENT_BASE_VERSION in cli/lib/constants.bash; a
# contract test checks this.
AGENT_BASE_VERSION=1
