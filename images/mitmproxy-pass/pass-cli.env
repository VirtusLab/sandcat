# Single source of truth for the pinned Proton Pass CLI (pass-cli) build.
#
# Consumed by:
#   - images/mitmproxy-pass/Dockerfile  (passed in as --build-arg)
#   - .github/workflows/build-mitmproxy-pass-image.yml
#   - cli/test/mitmproxy/test_mitmproxy_addon.py  (PAT-detection contract test)
#
# pass-cli is pinned by version AND per-arch sha256, so the binary — and its
# `pass-cli info` output contract that the PAT-detection heuristic relies on —
# cannot change under us without editing this file.
#
# When bumping the version:
#   1. Update PASS_CLI_VERSION and BOTH checksums below.
#   2. Re-capture the golden `pass-cli info` samples and bump their VERSION.
#      See cli/test/mitmproxy/fixtures/pass-cli/README.md
#
# Format note: simple KEY=value lines only (no quotes, no spaces around `=`) so
# this file is consumable by `source`, GitHub Actions $GITHUB_ENV, and the
# minimal parser in the contract test alike.
PASS_CLI_VERSION=2.1.2
PASS_CLI_SHA256_X86_64=5291edd21d85d222538b91341345ae3b0a1479e254d42920c2bbbd34012c6243
PASS_CLI_SHA256_AARCH64=0562625812f940bd4b7abd664b3bbcfefdeaf79d2f9b12f2d0a73be1ffc551ff
