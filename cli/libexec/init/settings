#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=../../lib/betteropts/betteropts.sh
source "$SCT_LIBDIR/betteropts/betteropts.sh"
# shellcheck source=../../lib/logging.bash
source "$SCT_LIBDIR/logging.bash"
# shellcheck source=../../lib/require.bash
source "$SCT_LIBDIR/require.bash"
# shellcheck source=../../lib/constants.bash
source "$SCT_LIBDIR/constants.bash"

# Creates a network settings file for the proxy.
# Outputs:
#   Creates a JSON settings file from template
# shellcheck disable=SC2154 # populated by betteropts_parse
settings() {
	summary "Creates a network settings file for the proxy."

	argument settings_file required \
		help="Path to the settings file"

	argument services variadic \
		help="Service names to include (e.g., claude, copilot, vscode, jetbrains, github)"

	betteropts_parse "$@"

	require yq

	mkdir -p "$(dirname -- "$settings_file")"
	cp \
		"$SCT_TEMPLATEDIR/settings.json" \
		"$settings_file"

	echo "Settings file created at $SCT_PROJECT_DIR/settings.json" | info
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]
then
	settings "$@"
fi
