#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=../../lib/logging.bash
source "$SCT_LIBDIR/logging.bash"
# shellcheck source=../../lib/require.bash
source "$SCT_LIBDIR/require.bash"
# shellcheck source=../../lib/path.bash
source "$SCT_LIBDIR/path.bash"

# Opens the mitmproxy console (TUI) for interactive traffic inspection.
# Replaces the web UI (mitmweb) with the console interface while keeping the
# WireGuard tunnel active so traffic keeps flowing. On exit (or Ctrl+C), the
# web UI is restored.
proxy() {
	require docker

	_proxy_compose_file="$(find_compose_file)"
	_proxy_override=$(mktemp "${TMPDIR:-/tmp}/sandcat-proxy-XXXXXX.yml")

	_proxy_restore() {
		echo "Restoring proxy (web mode)..." | info
		docker compose -f "$_proxy_compose_file" up -d --force-recreate mitmproxy 2>/dev/null || true
		docker compose -f "$_proxy_compose_file" restart wg-client 2>/dev/null || true
		rm -f "$_proxy_override"
		trap - EXIT INT TERM
	}
	trap _proxy_restore EXIT INT TERM

	# Build the command with any extra arguments the user passed
	local cmd="mitmproxy --mode wireguard -s /scripts/mitmproxy_addon.py"
	if [[ $# -gt 0 ]]; then
		cmd="$cmd $*"
	fi

	cat > "$_proxy_override" << YAML
services:
  mitmproxy:
    command: $cmd
    stdin_open: true
    tty: true
YAML

	echo "Switching proxy to console mode..." | info
	docker compose -f "$_proxy_compose_file" -f "$_proxy_override" up -d --force-recreate mitmproxy
	docker compose -f "$_proxy_compose_file" restart wg-client

	echo "Press 'q' to exit." | info

	local console_exit=0
	docker attach "$(docker compose -f "$_proxy_compose_file" ps -q mitmproxy)" || console_exit=$?

	_proxy_restore
	return "$console_exit"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]
then
	proxy "$@"
fi
