# Compose variable substitution for cli/templates/netbird-server/docker-compose.yml

NETBIRD_DASHBOARD_VERSION=v2.39.0
NETBIRD_SERVER_VERSION=0.72.4

NETBIRD_DASHBOARD_HTTP_PORT=8080
NETBIRD_MGMT_API_PORT=33073
NETBIRD_STUN_PORT=3478

# Filled at provision (openssl rand -base64 32) unless set before sandcat init.
NETBIRD_ENCRYPTION_KEY=
NETBIRD_RELAY_AUTH_SECRET=
