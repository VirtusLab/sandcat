# Pinned NetBird client binary for this example (copy of the sandcat mitmproxy pin).
#
# Consumed by compose-proxy-peer.yml build args. When bumping, keep in sync with
# cli/templates/devcontainer/sandcat/netbird.env.
#
# When bumping the version:
#   1. Update NETBIRD_VERSION and BOTH checksums below from the release assets:
#      https://github.com/netbirdio/netbird/releases/download/v<VERSION>/netbird_<VERSION>_checksums.txt
#   2. Look for netbird_<VERSION>_linux_amd64.tar.gz and netbird_<VERSION>_linux_arm64.tar.gz
#
# Format note: simple KEY=value lines only (no quotes, no spaces around `=`) so
# this file is consumable by `source`, compose build-arg injection, and contract
# tests alike.
NETBIRD_VERSION=0.28.9
NETBIRD_SHA256_AMD64=b678b79633dec4a876ca41933d6b1bdd22a7ccb646cd85a167ce0bf6482cea02
NETBIRD_SHA256_ARM64=f509dc45c1038fa189df26cf27e3dfd2334d01ca8b193df2706ead3b63038d55
