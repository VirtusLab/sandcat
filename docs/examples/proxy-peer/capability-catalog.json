{
  "capabilities": [
    {
      "name": "reach_proxy",
      "ref": "cap-reach-proxy",
      "type": "network",
      "dns_label": "proxy-peer.netbird.selfhosted",
      "peer_id": "peer-placeholder",
      "network": "0.0.0.0/32",
      "sync_mode": "route_enable",
      "proxy": {"port": 8080, "path_prefix": "/hello"},
      "lease_policy": {"quota": 5, "ttl_minutes": 15, "token_budget": 10000},
      "revoke_close_policy": "drain_deadline",
      "revoke_drain_seconds": 30
    }
  ]
}
