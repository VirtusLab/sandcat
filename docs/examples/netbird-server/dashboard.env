# Dashboard OIDC — API on netbird-server (host localhost:33073).
NETBIRD_MGMT_API_ENDPOINT=http://localhost:33073
NETBIRD_MGMT_GRPC_API_ENDPOINT=http://localhost:33073
AUTH_AUDIENCE=netbird-dashboard
AUTH_CLIENT_ID=netbird-dashboard
AUTH_CLIENT_SECRET=
AUTH_AUTHORITY=http://localhost:33073/oauth2
USE_AUTH0=false
AUTH_SUPPORTED_SCOPES=openid profile email groups
AUTH_REDIRECT_URI=/nb-auth
AUTH_SILENT_REDIRECT_URI=/nb-silent-auth
NETBIRD_TOKEN_SOURCE=idToken
NGINX_SSL_PORT=443
LETSENCRYPT_DOMAIN=none
